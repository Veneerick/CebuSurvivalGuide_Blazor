@page "/tips"
@inject IGuideDataService Data
<PageTitle>Survival Tips · Cebu Survival Guide</PageTitle>

<h1 class="text-[clamp(1.75rem,4vw,2.6rem)] font-black tracking-tight">Survival Tips</h1>
<p class="mt-1.5 text-neutral-700">Short, practical advice for getting around Cebu.</p>

<div class="mt-6 flex flex-wrap gap-2.5" role="group" aria-label="Filter tips">
    @foreach (var c in Categories)
    {
        <button class="border-2 border-ink px-4 py-2 font-bold hover:bg-paper @(c == category ? "bg-yel shadow-[3px_3px_0_var(--color-ink)]" : "bg-white")"
                aria-pressed="@(c == category)" @onclick="() => category = c">@c</button>
    }
</div>

<div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    @foreach (var t in Data.Tips.Where(t => category == "All" || t.Category == category))
    {
        <article class="card">
            <span class="inline-block border-2 border-ink px-2 text-xs font-extrabold @Badge(t.Category)">@t.Category</span>
            <h2 class="mt-3 mb-1.5 text-xl font-extrabold">@t.Title</h2>
            <p class="text-neutral-700">@t.Body</p>
        </article>
    }
</div>

@code {
    private string category = "All";
    private IEnumerable<string> Categories => new[] { "All" }.Concat(Data.Tips.Select(t => t.Category).Distinct());

    private static string Badge(string c) => c switch
    {
        "Transport" => "bg-blu",
        "Safety" => "bg-grn",
        _ => "bg-amb"
    };
}
