@page "/services"
@inject IGuideDataService Data
@inject IJSRuntime JS
<PageTitle>Essential Services · Cebu Survival Guide</PageTitle>

<h1 class="text-[clamp(1.75rem,4vw,2.6rem)] font-black tracking-tight">Essential Services</h1>
<p class="mt-1.5 text-neutral-700">Important emergency contacts and services in Cebu.</p>

<div class="mt-6 grid gap-5 md:grid-cols-2">
    @foreach (var s in Data.EmergencyServices)
    {
        <div class="card flex flex-col gap-1.5 border-t-[10px] border-t-sos">
            <div class="tile bg-sos text-white"><Icon Name="@s.Icon" /></div>
            <h3 class="mt-3.5 text-xl font-extrabold">@s.Name</h3>
            <div class="text-[2.5rem] leading-none font-black tracking-tight text-sos">@s.Number</div>
            <p class="text-neutral-700">@s.Description</p>
            <a class="btn btn-red mt-3 max-sm:py-4 max-sm:text-lg" href="tel:@s.Number"><Icon Name="phone" /> Call Now</a>
            <button class="btn max-sm:py-3" @onclick="() => Copy(s)">@(copied == s.Name ? "Copied" : "Copy number")</button>
        </div>
    }
</div>

<div class="mt-6 border-2 border-ink bg-amb px-4 py-3 text-sm"><b>Tip:</b> 911 is the national emergency hotline. Please confirm local numbers with official sources before relying on them.</div>

<h2 class="sec">Non-emergency services</h2>
<div class="grid gap-5 md:grid-cols-2">
    @foreach (var o in Data.OtherServices)
    {
        <div class="card flex items-center gap-3.5 p-4"><div class="tile"><Icon Name="@o.Icon" /></div><span><b class="block">@o.Name</b><small class="text-neutral-700">@o.Description</small></span></div>
    }
</div>

@code {
    private string? copied;

    private async Task Copy(EmergencyService s)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", s.Number);
            copied = s.Name;
        }
        catch (JSException)
        {
            copied = null; // clipboard unavailable (for example, insecure context)
        }
    }
}
